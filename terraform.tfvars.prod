# terraform.tfvars.prod
aws_region       = "ap-south-1"
project_name     = "multi-env-demo"
instance_type    = "t3.small"
instance_count   = 3
root_volume_size = 20
monitoring       = true

ami_owner        = "099720109477"
ami_name_pattern = "ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*"